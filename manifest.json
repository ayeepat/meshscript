{
  "manifest_version": 3,
  "minimum_chrome_version": "140",
  "name": "СМЭШ AI",
  "version": "0.5.0",
  "description": "Личный ИИ-помощник по домашним заданиям для электронного дневника МЭШ (school.mos.ru).",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://uchebnik.mos.ru/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "https://gdz-ru.com/*",
    "https://*.gdz-ru.com/*",
    "https://gdz.ru/*",
    "https://*.smeshai.xyz/*",
    "https://smeshapi.site/*",
    "https://ai.smeshapi.site/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "СМЭШ AI",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/settings/settings.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.mos.ru/diary/*"
      ],
      "js": ["src/content/scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://uchebnik.mos.ru/*",
        "https://school.mos.ru/*"
      ],
      "exclude_matches": [
        "https://school.mos.ru/diary/*"
      ],
      "js": ["src/content/test-pill.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*.woff2", "assets/icons/logo-mark.png"],
      "matches": ["https://school.mos.ru/*", "https://uchebnik.mos.ru/*"]
    }
  ]
}
