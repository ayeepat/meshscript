{
  "manifest_version": 3,
  "name": "СМЭШ AI",
  "version": "0.5.0",
  "description": "Personal homework assistant for the Mesh (school.mos.ru) platform.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": [
    "https://school.mos.ru/*",
    "https://*.mos.ru/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://gdz-ru.com/*",
    "https://*.gdz-ru.com/*",
    "https://gdz.ru/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gdz_ua",
        "enabled": true,
        "path": "src/rules/gdz-ua.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "СМЭШ AI",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/settings/settings.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.mos.ru/diary/*"
      ],
      "js": ["src/content/scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
