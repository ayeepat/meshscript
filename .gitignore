# macOS
.DS_Store
.secrets/
.env*
.dev.vars*

# Chrome-generated DNR artifact (regenerated on load — must not be committed)
_metadata/

# Packaged extension builds (generated by the store-zip step — never commit)
*.zip

# Dependencies (backend/ already ignores its own; this covers motion/ and any
# future workspace) and the motion ad project's rendered videos / QA frames
node_modules/
motion/build/
motion/output/
motion/qa_assets/
