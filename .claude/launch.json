{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "СМЭШ AI",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "."],
      "port": 4173
    },
    {
      "name": "smesh-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "${env:SMESH_SITE_DIR}"
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4599", "--bind", "127.0.0.1", "--directory", "${env:SMESH_DASHBOARD_DIR}"],
      "port": 4599
    }
  ]
}
